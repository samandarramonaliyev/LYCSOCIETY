# Development defaults (copy this file for local work only)
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-running
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL (the project deliberately has no SQLite fallback)
DJANGO_DB_NAME=lyc_society
DJANGO_DB_USER=lyc_society
DJANGO_DB_PASSWORD=replace-with-a-local-development-password
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=prefer
# Optional explicit test database name. Django otherwise derives one automatically.
# DJANGO_DB_TEST_NAME=test_lyc_society

# Telegram Mini App authentication (required for Phase 2; keep the real value out of source control)
TELEGRAM_BOT_TOKEN=replace-with-the-bot-token-from-secret-management
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
TELEGRAM_INIT_DATA_FUTURE_SKEW_SECONDS=30
# Optional request-throttle overrides
# TELEGRAM_AUTH_THROTTLE_RATE=20/hour
# STUDENT_VERIFICATION_THROTTLE_RATE=5/hour
# JOIN_REQUEST_THROTTLE_RATE=20/hour
# REPORT_SUBMISSION_THROTTLE_RATE=10/hour
# TELEGRAM_INVITE_THROTTLE_RATE=10/hour

# Optional locally; required in production whenever inbound webhook processing is enabled.
# Use only letters, numbers, underscores, and hyphens (1-256 chars). Never use a real
# secret in tests or commit it. The bot token never belongs in the webhook URL.
TELEGRAM_WEBHOOK_ENABLED=false
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Production required variables (use a secret manager; placeholders only)
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_DB_SSLMODE=verify-full
# DJANGO_CACHE_URL=rediss://:replace-with-cache-secret@cache.example.com:6380/0
# DJANGO_CACHE_SOCKET_TIMEOUT_SECONDS=2
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_TRUST_PROXY_SSL_HEADER=true  # only behind a trusted proxy that overwrites X-Forwarded-Proto
# DJANGO_HSTS_SECONDS=86400           # stage first; increase after HTTPS verification
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_HSTS_PRELOAD=false
# TELEGRAM_BOT_TOKEN=replace-with-a-newly-rotated-production-token
# TELEGRAM_WEBHOOK_ENABLED=true
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-new-random-secret
