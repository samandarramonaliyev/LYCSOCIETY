# This file is optional: the default relative API path already works with the
# Vite development proxy. VITE_* values are embedded in browser assets, so they
# must never contain Django, database, Telegram, or webhook secrets.
VITE_API_BASE_URL=/api/v1
# If frontend and API are deliberately hosted on exact separate HTTPS origins,
# set this to that public API path. Never place server secrets in VITE_* values.
